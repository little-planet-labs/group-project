{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "groupproject-screener",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Reached only at https://groupproject-screener.<account>.workers.dev (the App's webhook URL).
  // Deliberately no routes or custom domains on groupproject.lol / groupproject.dev.
  "workers_dev": true,
  "preview_urls": false
  // Secrets (set with `wrangler secret put`, never in this file):
  // GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET, TYPESAFE_API_KEY
}
